# MacroChipz backend environment contract.
#
# This file documents VARIABLE NAMES and safe placeholder values only.
# Never commit a real secret here or anywhere else in the repository.
#
# Legend:
#   [REQUIRED]     production will not work correctly without it
#   [OPTIONAL]     the feature it enables is optional; absent = disabled
#   [DEV ONLY]     never set in production
#   [TUNING]       has a working default; set only to override
#
# `ENVIRONMENT=production` switches several defaults from permissive to
# closed (see app/core/config.py). A production deployment missing
# anything it needs logs a named startup error listing the variable.

# ---------------------------------------------------------------------
# Deployment mode
# ---------------------------------------------------------------------

# [REQUIRED in production] `production` enables the closed defaults:
# API docs off, operator endpoints fail-closed, JSON logging.
# Anything else (unset, "development") means local development.
ENVIRONMENT=development

# [OPTIONAL] Build/commit identifier reported by /readiness. The Docker
# image excludes .git, so production should pass this as a build arg.
APP_VERSION=

# ---------------------------------------------------------------------
# Database  [REQUIRED]
# ---------------------------------------------------------------------

DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/economic_intelligence

# [TUNING] Seconds to wait for a TCP connection before failing into the
# 503 every route already handles. Default 10.
DATABASE_CONNECT_TIMEOUT_SECONDS=

# [TUNING] Seconds before a pooled connection is recycled. Default 1800.
DATABASE_POOL_RECYCLE_SECONDS=

# ---------------------------------------------------------------------
# Data providers
# ---------------------------------------------------------------------

# [REQUIRED] FRED backs series sync, discovery and the release calendar.
FRED_API_KEY=your_fred_api_key_here

# The U.S. Treasury rate feeds are unauthenticated public government
# data. There is deliberately no key to configure here.

# ---------------------------------------------------------------------
# MacroChipz Analyst  [OPTIONAL — the product works fully without it]
# ---------------------------------------------------------------------

# Both must be set for the Analyst to be available. With either unset,
# /api/v1/analyst/availability reports available:false and every
# canonical page is unaffected.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# [TUNING] Cost controls. Defaults: 700 output tokens per answer, and
# 10 requests per 60 seconds per client.
#
# NOTE: the rate limit is IN-PROCESS and PER-INSTANCE. It is correct
# only for a single-instance deployment. See app/api/rate_limit.py.
ANALYST_MAX_OUTPUT_TOKENS=
ANALYST_RATE_LIMIT_REQUESTS=
ANALYST_RATE_LIMIT_WINDOW_SECONDS=

# ---------------------------------------------------------------------
# HTTP surface
# ---------------------------------------------------------------------

# [REQUIRED in production] Exact browser origins allowed to call this
# API, comma-separated. NEVER a wildcard. The deployed frontend is on a
# separate origin, so without this every browser request from the UI
# fails. Leave empty locally: the Vite dev server proxies /api
# same-origin, so no CORS is involved.
#   CORS_ALLOWED_ORIGINS=https://macrochipz.onrender.com
CORS_ALLOWED_ORIGINS=

# [REQUIRED in production] Shared secret protecting the three operator
# write endpoints (series sync, rates sync, release sync). Each of these
# drives outbound provider traffic and writes canonical data.
#
# Send it as the `X-Operator-Token` header:
#   curl -X POST -H "X-Operator-Token: $OPERATOR_TOKEN" \
#        https://<api>/api/v1/series/PCEPILFE/sync
#
# Unset in production, those endpoints refuse every request (503) rather
# than standing open. Unset in development they are simply open, which
# is harmless on localhost.
#
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
OPERATOR_TOKEN=

# [TUNING] Largest accepted request body in bytes. Default 65536 — every
# legitimate request here is a small JSON document.
MAX_REQUEST_BODY_BYTES=

# ---------------------------------------------------------------------
# Observability  [TUNING]
# ---------------------------------------------------------------------

# Default INFO. Application logs are emitted on the `app` logger.
LOG_LEVEL=

# `json` or `text`. Defaults to json in production, text otherwise.
LOG_FORMAT=

# ---------------------------------------------------------------------
# Legacy / development-only
# ---------------------------------------------------------------------

# [DEV ONLY] The superseded Increment-8 tool-calling AI route
# (POST /api/v1/ai/query). Unmounted by default and NEVER mountable when
# ENVIRONMENT=production. Superseded by the Analyst (#33).
ENABLE_LEGACY_AI_ROUTE=

# [DEV ONLY] Force interactive API docs on or off. Defaults to on in
# development, off in production.
EXPOSE_API_DOCS=

# [DEV ONLY] Trusted proxy addresses for uvicorn's --forwarded-allow-ips.
# Defaults to * in the container, which is correct only because the
# platform is the sole ingress.
FORWARDED_ALLOW_IPS=
