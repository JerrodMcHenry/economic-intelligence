# Base URL for the FastAPI backend.
#
# Leave empty for local development: the Vite dev server proxies
# `/api` to the local backend (see vite.config.ts's BACKEND_PROXY_TARGET,
# which defaults to http://localhost:8000 -- FastAPI's default `uvicorn`
# port), so relative request paths like `/api/v1/...` already resolve
# correctly with no value set here.
#
# In production, set this to the deployed API's own origin, e.g.:
#   VITE_API_BASE_URL=https://api.example.com
#
# IMPORTANT: every variable prefixed VITE_ is bundled into client-side
# JavaScript and is publicly visible in the browser. This is
# configuration, not a secret -- never put an API key, database URL, or
# any other secret value in a VITE_-prefixed variable.
VITE_API_BASE_URL=

# Analytics provider (Increment #37). OPTIONAL -- leave unset.
#
# Unset, empty, or unrecognised = analytics is DISABLED and every
# `track()` call is a silent no-op. That is the default and the
# supported production state as of #37: no provider has been selected
# yet (see docs/architecture/product-measurement.md "Provider
# decision"), so this variable exists to be filled in later without
# touching application code.
#
# Recognised values:
#   debug   Logs events to the browser console. Local development only
#           -- refused in a production build.
#
# A test run always uses the no-op regardless of this value.
#
# This is configuration, not a secret. Like every VITE_-prefixed
# variable it is bundled into client-side JavaScript and is publicly
# visible in the browser -- never put a key or a token here.
VITE_ANALYTICS_PROVIDER=
